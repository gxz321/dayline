# Copy these SETTINGS into the ignored app-root .env.local. Never put secrets in VITE_*.
# Run `node standalone/setup.mjs` to create these two values securely; no default login.
STANDALONE_PASSWORD_HASH=
STANDALONE_SESSION_SECRET=
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Required exact HTTPS origin in production. TLS is terminated by your trusted reverse proxy.
PUBLIC_ORIGIN=
# Use a writable persistent disk; one process / one instance only.
# DATA_DIR=/var/lib/dayline
AUTO_REFRESH=false
CHAT_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# If choosing a mainland-accessible provider, obtain its own service-side key securely.
# AI_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Limits are deliberately pinned by the standalone adapter: 20 requests/day, 800 output tokens.
# Telegram remains disabled until the owner deliberately supplies all required settings.
TELEGRAM_ENABLED=false
