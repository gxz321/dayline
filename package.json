{
  "name": "dayline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-worker.mjs",
    "preview": "node scripts/preview-worker.mjs",
    "start": "node standalone/server.mjs --env-file=.env.local",
    "setup": "node standalone/setup.mjs",
    "build:pages": "vite build --mode github-pages --outDir pages-dist"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
